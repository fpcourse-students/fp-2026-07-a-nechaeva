-- Regression: typed literals invalidate claims that Int or Bool are empty.
language typed
vars value

zero := 0
one := 1
yes := true
no := false
feedInt := \consume. consume 0
feedBool := \consume. consume true
add := plus
openInt := plus value 0

task 1.1 (Int with requested count is inhabited)
inhabit Int (2): none

task 1.2 (Int without requested count is inhabited)
inhabit Int: none

task 1.3 (Bool with requested count is inhabited)
inhabit Bool (2): none

task 1.4 (Bool without requested count is inhabited)
inhabit Bool: none

task 1.5 (a type variable stays uninhabited)
inhabit a: none

task 1.6 (none is allowed when no inhabitants exist even with a count)
inhabit a (2): none

task 2.1 (a function can return an Int literal)
inhabit a -> Int: none

task 2.2 (a function can return a Bool literal)
inhabit a -> Bool: none

task 2.3 (an Int literal can be passed to a bound function)
inhabit (Int -> a) -> a: none

task 2.4 (a Bool literal can be passed to a bound function)
inhabit (Bool -> a) -> a: none

task 2.5 (an Int literal cannot provide an arbitrary result type)
inhabit Int -> a: none

task 2.6 (a Bool literal cannot provide an arbitrary result type)
inhabit Bool -> a: none

task 3.1 (valid Int inhabitants still pass)
inhabit Int (2): zero, one

task 3.2 (valid Bool inhabitants still pass)
inhabit Bool (2): yes, no

task 3.3 (the Int-consuming function has a closed inhabitant)
inhabit (Int -> a) -> a: feedInt

task 3.4 (the Bool-consuming function has a closed inhabitant)
inhabit (Bool -> a) -> a: feedBool

task 3.5 (too few listed inhabitants are rejected)
inhabit Int (2): zero

task 3.6 (contradictory answers do not yield DONE)
inhabit Int (2): none
inhabit Int (2): zero, one

task 3.7 (a primitive is a closed inhabitant)
inhabit Int -> Int -> Int: add

task 3.8 (a declared free variable is not a closed inhabitant)
inhabit Int: openInt

task 3.9 (a closed primitive of the wrong type is rejected)
inhabit Int: yes
