-- Deliberate mistakes; expected statuses are in Test.hs.
language pure
import prelude
vars x y

task 1.1 (дырка)
t := ...
expect t x = x

task 1.2 (неверный ответ, PARTIAL)
or := \p q. p q q
expect or true false = true
expect or false false = false

